rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Notes uploads — any authenticated user can upload, anyone can read
    match /notes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Lost & Found photo uploads
    match /lostfound/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Event poster uploads
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
